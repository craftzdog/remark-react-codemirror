{
  "name": "remark-react-codemirror",
  "version": "1.1.3",
  "description": "Syntax highlighting for remark-react through CodeMirror",
  "main": "lib/index.js",
  "scripts": {
    "build": "babel src -d lib --extensions '.jsx'",
    "watch": "babel src --watch -d lib --extensions '.jsx'",
    "lint": "eslint src",
    "format": "prettier -w 'src/**/*.jsx'",
    "test": "vitest",
    "prepublish": "npm test; npm run build"
  },
  "keywords": [
    "remark",
    "react",
    "codemirror",
    "syntax",
    "highlight"
  ],
  "author": "Takuya Matsuyama <hi@craftz.dog>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/craftzdog/remark-react-codemirror.git"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "codemirror": "^6.0.2",
    "deepmerge": "^4.3.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-react": "^8.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react-codemirror-runmode": "^2.1.0"
  },
  "peerDependencies": {
    "prop-types": ">= 15.6.0",
    "react": ">= 0.11.2"
  }
}
